{
    "name": "IPUC LA FONDA - Iglesia Pentecostal Unida de Colombia",
    "short_name": "IPUC LA FONDA",
    "description": "Plataforma oficial de IPUC LA FONDA. Donde el Espíritu Santo se mueve. Accede a cultos, eventos, noticias, devocionales y comunidad cristiana.",
    "start_url": "/",
    "scope": "/",
    "id": "ipuc-la-fonda-v5.1",
    
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui"
    ],
    "orientation": "any",
    
    "background_color": "#1a237e",
    "theme_color": "#1a237e",
    
    "lang": "es-CO",
    "dir": "ltr",
    
    "categories": [
        "social",
        "lifestyle",
        "utilities",
        "education",
        "books",
        "religion"
    ],
    "prefer_related_applications": false,
    "iarc_rating_id": "e10+",
    
    "launch_handler": {
        "client_mode": [
            "navigate-existing",
            "auto"
        ]
    },
    
    "edge_side_panel": {
        "preferred_width": 400
    },
    
    "handle_links": "preferred",
