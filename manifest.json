    "related_applications": [],
    
    "protocol_handlers": [
        {
            "protocol": "web+ipuc",
            "url": "/?action=%s"
        }
    ],
    
    "share_target": {
        "action": "/#publicaciones",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp"],
                "text/*": [".txt", ".md"]
            }
        }
    ],
    
    "note_taking": {
        "new_note_url": "/#publicaciones?action=new"
    },
    
    "widgets": [
        {
            "name": "Versículo del Día",
            "short_name": "Versículo",
            "description": "Versículo bíblico diario de IPUC LA FONDA",
