            "screenshots": [
                {
                    "src": "/assets/widgets/verse-screenshot.png",
                    "sizes": "300x200",
                    "type": "image/png"
                }
            ],
            "data": {
                "api": "/api/verse",
                "update": "daily"
            }
        },
        {
