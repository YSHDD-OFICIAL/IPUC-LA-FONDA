    "related_applications": [],

    "protocol_handlers": [
        {
            "protocol": "web+ipuc",
            "url": "/?action=%s"
        },
        {
            "protocol": "web+ipuc-prayer",
            "url": "/#peticiones?prayer=%s"
        },
        {
            "protocol": "web+ipuc-event",
            "url": "/#eventos?event=%s"
        },
        {
            "protocol": "web+ipuc-music",
            "url": "/#musica?track=%s"
        },
        {
            "protocol": "web+ipuc-podcast",
            "url": "/#podcast?episode=%s"
        },
        {
            "protocol": "web+ipuc-notice",
            "url": "/#noticias?notice=%s"
        },
        {
            "protocol": "web+ipuc-user",
            "url": "/#directorio?user=%s"
        },
        {
            "protocol": "web+ipuc-group",
            "url": "/#grupos?group=%s"
        }
    ],

    "share_target": {
        "action": "/#publicaciones",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "image",
                    "accept": ["image/*"]
                },
                {
                    "name": "audio",
                    "accept": ["audio/*"]
                },
                {
                    "name": "video",
                    "accept": ["video/*"]
                }
            ]
        }
    },

    "file_handlers": [
        {
            "action": "/#biblioteca?upload=true",
            "accept": {
                "application/pdf": [".pdf"],
                "text/plain": [".txt", ".md"],
                "application/msword": [".doc", ".docx"],
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
                "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"],
                "audio/*": [".mp3", ".wav", ".ogg", ".m4a"],
                "video/*": [".mp4", ".webm", ".ogg"],
                "application/epub+zip": [".epub"],
                "application/x-mobipocket-ebook": [".mobi"]
            }
        }
    ],

    "note_taking": {
        "new_note_url": "/#publicaciones?action=new"
    },

    "prefer_related_applications": false,

    "serviceworker": {
        "src": "/service-worker.js",
        "scope": "/",
        "use_cache": true,
        "update_via_cache": "all"
    },

    "splash_pages": {
        "dark": {
            "background_color": "#0a0a1a",
            "image": "/assets/splash/dark-splash.png"
        },
        "light": {
            "background_color": "#1a237e",
            "image": "/assets/splash/light-splash.png"
        }
    },

    "tabstrip": {
        "home_tab": {
            "scope": "/",
            "start_url": "/#inicio",
            "icons": [
                {
                    "src": "/assets/icons/icon-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    },

    "isolated_storage": true,

    "share_auto": {
        "action": "/#publicaciones",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },

    "window_controls_overlay": {
        "show": true,
        "title": "IPUC LA FONDA"
    },

    "notifications": {
        "enabled": true,
        "vibrate": [100, 50, 100],
        "sound": "/assets/sounds/notification.mp3",
        "icon": "/assets/icons/icon-192x192.png",
        "badge": "/assets/icons/badge-icon.png"
    },

    "background_sync": {
        "enabled": true,
        "network_timeout": 30000
    },

    "web_share": {
        "enabled": true,
        "title": "IPUC LA FONDA",
        "text": "Where the Holy Spirit moves",
        "url": "https://ipuclafonda.netlify.app/"
    }
}
